#!/bin/sh
# Runs INSIDE the container, as the first command scripts/guix-env starts
# (ADR-0006). Exports what the Makefile and the suites take from the
# profile, then runs the command:
#
#   CHEZ                  the profile's scheme, the real binary: a symlink
#                         named chez breaks Chez's boot-file lookup, and a
#                         wrapper script hides Chez from Valgrind
#   CC                    the profile's gcc: gcc-toolchain installs no cc
#   CHEZ_SQLITE3_LIBRARY  the profile's libsqlite3.so.0, by absolute path,
#                         so no suite depends on discovery (ADR-0002)
#
# It sets no LD_LIBRARY_PATH. Nothing here loads a library by bare name,
# and with it unset no such load can work by accident.
set -eu

die() { printf 'guix-env-enter: %s\n' "$*" >&2; exit 2; }

if [ -z "${GUIX_ENVIRONMENT:-}" ]; then
  die "not inside a Guix environment; use scripts/guix-env"
fi

# need FILE: dies unless FILE is a regular file, or a symlink to one.
need() {
  [ -f "$1" ] || die "no $1 in the profile; is its package in manifest.scm?"
}

need "$GUIX_ENVIRONMENT/bin/scheme"
need "$GUIX_ENVIRONMENT/bin/gcc"
need "$GUIX_ENVIRONMENT/lib/libsqlite3.so.0"

export CHEZ="$GUIX_ENVIRONMENT/bin/scheme"
export CC="$GUIX_ENVIRONMENT/bin/gcc"
export CHEZ_SQLITE3_LIBRARY="$GUIX_ENVIRONMENT/lib/libsqlite3.so.0"

exec "$@"

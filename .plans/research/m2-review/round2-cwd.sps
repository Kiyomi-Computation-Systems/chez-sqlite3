(import (chezscheme) (chez-sqlite3) (chez-sqlite3 private connection))
(define (count) (let ([n (disable-interrupts)]) (enable-interrupts) n))
(define (probe label thunk)
  (let ([seen (call/cc (lambda (k)
                (with-exception-handler
                  (lambda (c) (k (list (count) (if (sqlite-error? c) 'sqlite-error (if (sqlite-closed? c) 'closed (if (assertion-violation? c) 'assertion 'other))))))
                  (lambda () (thunk) 'no-raise))))])
    (printf "~a: handler's disable count, kind: ~s (outside: ~s)~n" label seen (count))))
(probe "open-database, a missing file read-write" (lambda () (open-database "build/rev2/no-such-dir/x.db" 'read-write)))
(probe "call-with-database, a missing file read-write" (lambda () (call-with-database "build/rev2/no-such-dir/x.db" 'read-write (lambda (db) 'body))))
(let ([db (open-database ":memory:")])
  (close-database! db)
  (probe "call-with-open-handle on a closed database" (lambda () (call-with-open-handle 'probe db (lambda (h) h)))))
(probe "call-with-database, the body raising" (lambda () (call-with-database ":memory:" (lambda (db) (raise 'body)))))
(exit 0)

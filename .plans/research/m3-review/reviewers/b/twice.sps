#!r6rs
(import (rnrs) (only (chezscheme) make-engine collect collect-trip-bytes printf) (rnrs eval))
(define env (environment '(chez-sqlite3)))
(define open-database (eval 'open-database env))
(define close-database! (eval 'close-database! env))
(define execute! (eval 'execute! env))
(define query (eval 'query env))
(define sqlite-closed? (eval 'sqlite-closed? env))
(define (attempt thunk)
  (guard (e ((sqlite-closed? e) 'closed) (#t (list 'raised (condition-message e))))
    (thunk) 'answered))
(collect-trip-bytes (* 64 1024 1024))
(let loop ((fuel 1))
  (when (<= fuel 30)
    (collect)
    (let* ((db (open-database ":memory:"))
           (_ (execute! db "create table t (x)"))
           (r #f)
           (first ((make-engine (lambda () (attempt (lambda () (execute! db "insert into t values (?)" 9)))))
                   fuel (lambda (left v) (list 'completed v)) (lambda (next) (set! r next) 'expired))))
      (if (eq? first 'expired)
          (let* ((a (r 100000000 (lambda (left v) v) (lambda (next) 'expired-again)))
                 (b (r 100000000 (lambda (left v) v) (lambda (next) 'expired-again)))
                 (rows (length (query db "select x from t"))))
            (printf "fuel ~a: first resume ~a, second resume ~a, rows ~a\n" fuel a b rows))
          (printf "fuel ~a: completed unexpired, rows ~a\n" fuel (length (query db "select x from t"))))
      (close-database! db)
      (if (eq? first 'expired) (loop (+ fuel 1)) #t))))

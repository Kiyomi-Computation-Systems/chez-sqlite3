#!r6rs
(import (chezscheme) (chez-sqlite3))
(define n-stmts 8)
(define script
  (let loop ((i 1) (acc ""))
    (if (> i n-stmts) acc
        (loop (+ i 1) (string-append acc "insert into t values(" (number->string i) ");")))))
(define (trial t1 t2)
  (let ((db (open-database ":memory:")))
    (execute! db "create table t(x)")
    (let* ((k1 #f) (fired 0) (used #f) (trace '())
           (base (total-changes db))
           (outcome
            (guard (e (#t (list 'raised (and (condition? e) (who-condition? e) (condition-who e)) (sqlite-closed? e))))
              (timer-interrupt-handler
               (lambda ()
                 (set! fired (+ fired 1))
                 (set! trace (cons (- (total-changes db) base) trace))
                 (cond ((= fired 1)
                        (call/cc (lambda (k) (set! k1 k)))
                        (set-timer t2))
                       ((and (>= fired 2) (not used))
                        (set! used #t)
                        (k1 #f)))))
              (set-timer t1)
              (execute-script! db script)
              (set-timer 0)
              'returned)))
      (set-timer 0)
      (let ((rows (map (lambda (r) (vector-ref r 0)) (query db "select x from t order by rowid"))))
        (close-database! db)
        (list t1 t2 fired (reverse trace) outcome rows)))))
(define tally (make-hashtable equal-hash equal?))
(define shown 0)
(for-each (lambda (t2)
(let loop ((t1 950))
  (when (<= t1 1650)
    (let* ((r (trial t1 t2))
           (key (list (list-ref r 4) (length (list-ref r 5)))))
      (hashtable-update! tally key (lambda (n) (+ n 1)) 0)
      (when (and (> (length (list-ref r 5)) n-stmts) (< shown 6))
        (set! shown (+ shown 1)) (write r) (newline)))
    (loop (+ t1 1)))))
 '(40 80 150 230))
(let-values (((ks vs) (hashtable-entries tally))) (vector-for-each (lambda (k v) (write (list k v)) (newline)) ks vs))

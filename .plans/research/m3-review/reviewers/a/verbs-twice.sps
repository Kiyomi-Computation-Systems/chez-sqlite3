#!r6rs
;; Probe: each writing verb under an engine; the first expiry's remainder R
;; resumed to its end, then again to its end. Counts writes after each, and
;; the fuels at which R's second resume wrote again.
(import (chezscheme) (chez-sqlite3))
(define (run-engine e fuel)
  (e fuel (lambda (ticks . vals) (cons 'completed vals)) (lambda (r) (list 'expired r))))
(define (describe e)
  (cond ((sqlite-closed? e) 'closed) ((sqlite-transaction-ended? e) 'ended)
        ((sqlite-error? e) (list 'sqlite-error (sqlite-error-code e)))
        ((and (condition? e) (message-condition? e)) (list 'other (condition-message e))) (else (list 'other e))))
(define (guarded thunk) (lambda () (guard (e (#t (list 'raised (describe e)))) (thunk))))
(define (rows db) (vector-ref (query-row db "select count(*) from t") 0))
(define (sweep name call)
  (let loop ((f 1) (again '()))
    (let ((db (open-database ":memory:")))
      (execute! db "create table t(x)")
      (let* ((e (make-engine (guarded (lambda () (call db f)))))
             (first (run-engine e f)))
        (if (eq? (car first) 'completed)
            (begin (close-database! db)
                   (printf "~a: completed unexpired at fuel ~a; fuels whose second resume wrote again: ~a\n" name f (reverse again)))
            (let* ((r (cadr first))
                   (r1 (run-engine r 100000000)) (n1 (rows db))
                   (r2 (run-engine r 100000000)) (n2 (rows db)))
              (close-database! db)
              (loop (+ f 1) (if (> n2 n1) (cons (list f (cdr r2)) again) again))))))))
(sweep "execute!" (lambda (db f) (execute! db "insert into t values (?)" f)))
(sweep "query-row returning" (lambda (db f) (query-row db "insert into t values (?) returning x" f)))
(sweep "query" (lambda (db f) (query db "insert into t values (?) returning x" f)))
(sweep "query-fold" (lambda (db f) (query-fold db "insert into t values (?) returning x" (lambda (a r) a) 0 f)))
(sweep "execute-script!" (lambda (db f) (execute-script! db "insert into t values (1); insert into t values (2)")))
(sweep "with-transaction" (lambda (db f) (with-transaction db 'deferred (lambda () (execute! db "insert into t values (?)" f) 42))))
(sweep "with-transaction nested" (lambda (db f) (with-transaction db 'deferred (lambda () (with-transaction db (lambda () (execute! db "insert into t values (?)" f) 42))))))

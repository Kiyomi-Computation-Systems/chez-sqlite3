#!r6rs
(import (chezscheme) (chez-sqlite3) (only (chez-sqlite3 private conveniences) fold-marks fold-clear!))
(define (run-engine e fuel)
  (e fuel (lambda (ticks . vals) (cons 'completed vals)) (lambda (r) (list 'expired r))))
(define (describe e)
  (cond ((sqlite-closed? e) 'closed) ((sqlite-error? e) (list 'sqlite-error (sqlite-error-code e)))
        ((and (condition? e) (message-condition? e)) (list 'other (condition-message e))) (else (list 'other e))))
(define (guarded thunk) (lambda () (guard (e (#t (list 'raised (describe e)))) (thunk))))
(define (trial f)
  (let ((db (open-database ":memory:")) (calls 0))
    (execute! db "create table t(x)")
    (execute! db "insert into t values (1),(2),(3)")
    (let* ((e (make-engine (guarded (lambda () (query-fold db "select x from t" (lambda (acc row) (set! calls (+ calls 1)) (+ acc (vector-ref row 0))) 0)))))
           (first (begin (fold-clear!) (run-engine e f))))
      (if (eq? (car first) 'completed)
          (begin (close-database! db) 'completed-unexpired)
          (let* ((reached (reverse (fold-marks))) (r (cadr first))
                 (r1 (run-engine r 100000000)) (c1 calls)
                 (r2 (run-engine r 100000000)) (c2 (- calls c1)))
            (close-database! db)
            (list f 'first-slice-reached reached 'r1 (cdr r1) 'calls c1 'r2 (cdr r2) 'calls c2))))))
(let loop ((f 1))
  (let ((r (trial f)))
    (if (eq? r 'completed-unexpired)
        (printf "completed unexpired at fuel ~a\n" f)
        (begin (when (or (<= f 40) (> (list-ref r 10) 0)) (write r) (newline)) (loop (+ f 1))))))

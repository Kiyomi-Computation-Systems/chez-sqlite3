#!r6rs
;; Probe: each M3 verb on a closed connection, from the wrong thread, and on
;; a non-database; what raises, with its who and irritants.
(import (chezscheme) (chez-sqlite3))
(define (describe e)
  (cond ((sqlite-wrong-thread? e) (list 'wrong-thread (condition-who e)))
        ((sqlite-closed? e) (list 'closed (condition-who e)))
        ((sqlite-transaction-ended? e) (list 'ended (condition-who e)))
        ((sqlite-error? e) (list 'sqlite-error (sqlite-error-code e) (condition-who e)))
        ((assertion-violation? e) (list 'assertion (condition-who e) (if (irritants-condition? e) (condition-irritants e) '())))
        ((condition? e) (list 'other (and (who-condition? e) (condition-who e)) (and (message-condition? e) (condition-message e))))
        (else (list 'non-condition e))))
(define (try thunk) (guard (e (#t (describe e))) (call-with-values thunk (lambda vs (cons 'answered vs)))))
(define verbs
  (list (cons 'execute! (lambda (db) (execute! db "select 1")))
        (cons 'execute-script! (lambda (db) (execute-script! db "select 1; select 2")))
        (cons 'execute-script!-empty (lambda (db) (execute-script! db "")))
        (cons 'query (lambda (db) (query db "select 1")))
        (cons 'query-row (lambda (db) (query-row db "select 1")))
        (cons 'query-fold (lambda (db) (query-fold db "select 1" (lambda (a r) a) 0)))
        (cons 'changes changes)
        (cons 'total-changes total-changes)
        (cons 'last-insert-rowid last-insert-rowid)
        (cons 'in-transaction? in-transaction?)
        (cons 'with-transaction (lambda (db) (with-transaction db (lambda () 1))))
        (cons 'interrupt-database! interrupt-database!)))
(define (on-other-thread thunk)
  (let ((m (make-mutex)) (c (make-condition)) (result #f) (done #f))
    (fork-thread (lambda ()
                   (let ((r (try thunk)))
                     (with-mutex m (set! result r) (set! done #t) (condition-signal c)))))
    (with-mutex m (let loop () (unless done (condition-wait c m) (loop))))
    result))
(define db (open-database ":memory:"))
(printf "-- wrong thread\n")
(for-each (lambda (v) (write (list (car v) (on-other-thread (lambda () ((cdr v) db))))) (newline)) verbs)
(printf "-- not a database\n")
(for-each (lambda (v) (write (list (car v) (try (lambda () ((cdr v) 'nope))))) (newline)) verbs)
(close-database! db)
(printf "-- closed\n")
(for-each (lambda (v) (write (list (car v) (try (lambda () ((cdr v) db))))) (newline)) verbs)
(printf "-- closed, then wrong thread\n")
(for-each (lambda (v) (write (list (car v) (on-other-thread (lambda () ((cdr v) db))))) (newline)) verbs)
(printf "-- bad arguments on an open db\n")
(define db2 (open-database ":memory:"))
(for-each (lambda (p) (write (list (car p) (try (cdr p)))) (newline))
  (list (cons 'execute!-sql-not-string (lambda () (execute! db2 42)))
        (cons 'execute!-nul (lambda () (execute! db2 "select 1\x0;")))
        (cons 'execute!-two (lambda () (execute! db2 "select 1; select 2")))
        (cons 'execute!-none (lambda () (execute! db2 "  ")))
        (cons 'execute!-count (lambda () (execute! db2 "select ?" 1 2)))
        (cons 'execute!-bool (lambda () (execute! db2 "select ?" #t)))
        (cons 'execute!-secret-string (lambda () (execute! db2 "select ?, ?" 1 'sym)))
        (cons 'query-fold-proc (lambda () (query-fold db2 "select 1" 'notproc 0)))
        (cons 'with-transaction-mode (lambda () (with-transaction db2 'nope (lambda () 1))))
        (cons 'with-transaction-mode-string (lambda () (with-transaction db2 "secret" (lambda () 1))))
        (cons 'with-transaction-body (lambda () (with-transaction db2 'deferred 42)))
        (cons 'script-not-string (lambda () (execute-script! db2 'x)))
        (cons 'script-bad-sql (lambda () (execute-script! db2 "select 1; selec 2")))
        (cons 'settings-unknown (lambda () (open-database ":memory:" '((nope . 1)))))
        (cons 'settings-string (lambda () (open-database ":memory:" '((busy-timeout . "secret")))))
        (cons 'settings-two-lists (lambda () (open-database ":memory:" '() '())))
        (cons 'mismatch (lambda () (open-database ":memory:" '((journal-mode . wal)))))
        (cons 'mismatch-fields (lambda () (guard (e ((sqlite-setting-mismatch? e) (list (sqlite-setting-mismatch-setting e) (sqlite-setting-mismatch-expected e) (sqlite-setting-mismatch-actual e)))) (open-database ":memory:" '((journal-mode . wal))))))
        (cons 'mismatch-accessor-bad (lambda () (sqlite-setting-mismatch-setting "secret")))
        (cons 'interrupt-pred (lambda () (list (sqlite-interrupt? 1) (sqlite-transaction-ended? 1) (sqlite-setting-mismatch? 1))))))
(close-database! db2)

#!r6rs
;; Probe: the reference's watchdog, interrupting until the owner says it is
;; done, against with-transaction: can it stop with-transaction's own
;; ROLLBACK or COMMIT, leaving the transaction open after the call?
(import (chezscheme) (chez-sqlite3))
(define dir "build/m3cr-a/probes/tmp")
(system (string-append "mkdir -p " dir))
(define path (string-append dir "/wd.db"))
(system (string-append "rm -f " path " " path "-journal " path "-wal " path "-shm"))
(define db (open-database path '((journal-mode . wal))))
(execute! db "create table if not exists t(x)")
(define done #f)
(define m (make-mutex))
(define finished #f)
(define c (make-condition))
(fork-thread (lambda ()
               (let loop ()
                 (unless done (interrupt-database! db) (loop)))
               (with-mutex m (set! finished #t) (condition-signal c))))
(define (kind e)
  (cond ((sqlite-interrupt? e) 'interrupt) ((sqlite-error? e) (sqlite-error-code e))
        ((sqlite-transaction-ended? e) 'ended) ((symbol? e) e) (else 'other)))
(define tally (make-hashtable equal-hash equal?))
(define (note! k) (hashtable-update! tally k (lambda (n) (+ n 1)) 0))
(define alive-in-body 'not-reached)
(let loop ((i 0))
  (when (< i 20000)
    (set! alive-in-body 'not-reached)
    (let* ((raises? (even? i))
           (r (guard (e (#t (kind e)))
                (with-transaction db 'deferred
                  (lambda ()
                    (guard (e (#t (set! alive-in-body (guard (e2 (#t 'unknown)) (in-transaction? db))) (raise e)))
                      (execute! db "insert into t values (1)"))
                    (set! alive-in-body (guard (e2 (#t 'unknown)) (in-transaction? db)))
                    (when raises? (raise 'boom))
                    'ok))))
           (open (guard (e (#t 'unknown)) (in-transaction? db))))
      (note! (list (if raises? 'body-raises 'body-returns) r 'open-in-body alive-in-body 'left-open open))
      (when (eq? open #t)
        ;; clean up so the next trial starts fresh
        (let retry ((n 0)) (unless (or (> n 1000) (guard (e (#t #f)) (execute! db "rollback") #t)) (retry (+ n 1))))))
    (loop (+ i 1))))
(set! done #t)
(with-mutex m (let w () (unless finished (condition-wait c m) (w))))
(let-values (((ks vs) (hashtable-entries tally))) (vector-for-each (lambda (k v) (write (list k v)) (newline)) ks vs))
(close-database! db)

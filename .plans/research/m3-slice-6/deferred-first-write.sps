;; Does a deferred transaction's first statement, a write, wait under the busy timeout,
;; where one after a read answers busy at once? Two connections on one thread, WAL.
(import (chezscheme) (chez-sqlite3) (chez-sqlite3-testing))
(define (ms thunk)
  (let ((t0 (real-time)))
    (let ((r (guard (e ((sqlite-error? e) (list (sqlite-error-code e) (sqlite-error-extended-code e))))
               (thunk) 'ok)))
      (list r (- (real-time) t0)))))
(call-with-temp-directory
 (lambda (dir)
   (let ((path (string-append dir "/p.db")))
     (call-with-database path '((journal-mode . wal))
       (lambda (db) (execute! db "create table t (x)") (execute! db "insert into t values (1)")))
     (for-each
      (lambda (mode)
        (let ((holder (open-database path '((journal-mode . wal))))
              (waiter (open-database path '((journal-mode . wal) (busy-timeout . 1500)))))
          (execute! holder "begin immediate")
          (execute! holder "insert into t values (2)")
          (execute! waiter "begin")
          (when (eq? mode 'read-first) (query-row waiter "select count(*) from t"))
          (display (list mode (ms (lambda () (execute! waiter "insert into t values (3)")))
                         (in-transaction? waiter)))
          (newline)
          (execute! waiter "rollback")
          (execute! holder "rollback")
          (close-database! waiter)
          (close-database! holder)))
      '(write-first read-first)))))
(exit 0)

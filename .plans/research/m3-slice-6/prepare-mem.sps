#!r6rs
;; Probe: the watchdog holds SQLite's STATIC_MEM mutex across a 1 ms sleep,
;; then interrupts and lets go, so a prepare that mallocs while it parses
;; blocks there and the interrupt lands mid-parse, even under Valgrind.
(import (rnrs) (rnrs eval)
        (only (chezscheme) fork-thread make-mutex with-mutex make-condition condition-wait
              condition-signal sleep make-time real-time foreign-procedure))
(define (reach lib name) (eval name (environment lib)))
(define open-database (reach '(chez-sqlite3) 'open-database))
(define close-database! (reach '(chez-sqlite3) 'close-database!))
(define prepare-statement (reach '(chez-sqlite3) 'prepare-statement))
(define finalize-statement! (reach '(chez-sqlite3) 'finalize-statement!))
(define sqlite-error-code (reach '(chez-sqlite3) 'sqlite-error-code))
(define call-with-open-handle (reach '(chez-sqlite3 private connection) 'call-with-open-handle))
(define sqlite3-interrupt (reach '(chez-sqlite3 private native) 'sqlite3-interrupt))
(define mutex-alloc (foreign-procedure "sqlite3_mutex_alloc" (int) uptr))
(define mutex-enter (foreign-procedure "sqlite3_mutex_enter" (uptr) void))
(define mutex-leave (foreign-procedure "sqlite3_mutex_leave" (uptr) void))
(define static-mem (mutex-alloc 3))
(define args (cdr (command-line)))
(define n (string->number (car args)))
(define mode (string->symbol (cadr args)))
(define trials (string->number (caddr args)))
(define sql
  (call-with-string-output-port
   (lambda (p)
     (put-string p "SELECT 1 IN (")
     (let loop ((i 0)) (when (< i n) (put-string p "1, ") (loop (+ i 1))))
     (put-string p "1)"))))
(define (ms k) (make-time 'time-duration (* k 1000000) 0))
(define (trial)
  (let* ((db (open-database ":memory:"))
         (h (call-with-open-handle 'probe db (lambda (h) h)))
         (m (make-mutex)) (c (make-condition)) (done #f) (ended #f) (sent 0) (started #f)
         (t (fork-thread
             (lambda ()
               (let loop ()
                 (unless (with-mutex m done)
                   (case mode
                     ((hold)
                      (mutex-enter static-mem)
                      (with-mutex m (set! started #t) (condition-signal c))
                      (sleep (ms 1))
                      (sqlite3-interrupt h)
                      (mutex-leave static-mem)
                      (sleep (ms 1)))
                     ((none) (with-mutex m (set! started #t) (condition-signal c))))
                   (with-mutex m (set! sent (+ sent 1)))
                   (loop)))
               (with-mutex m (set! ended #t) (condition-signal c)))))
         (w (with-mutex m (let l () (unless started (condition-wait c m) (l)))))
         (t0 (real-time))
         (r (guard (e (#t (list 'raised (sqlite-error-code e))))
              (let ((st (prepare-statement db sql))) (finalize-statement! st) 'prepared)))
         (t1 (real-time)))
    (with-mutex m (set! done #t)
      (let w () (unless ended (condition-wait c m) (w))))
    (close-database! db)
    (list r (- t1 t0) 'ms (with-mutex m sent) 'rounds)))
(display (string-length sql)) (display " chars") (newline)
(let loop ((i 0))
  (when (< i trials)
    (write (trial)) (newline)
    (loop (+ i 1))))

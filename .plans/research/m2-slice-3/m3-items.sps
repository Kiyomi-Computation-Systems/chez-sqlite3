(import (rnrs) (rnrs eval) (chez-sqlite3 private conditions))
(define env (environment '(rnrs) '(chez-sqlite3 private connection) '(chez-sqlite3 private statement) '(chez-sqlite3 private conditions)))
(define (run expr)
  (guard (c (#t (list 'raised (if (sqlite-error? c)
                                  (list (sqlite-error-code c) (sqlite-error-extended-code c) (sqlite-error-message c) (sqlite-busy? c))
                                  (condition-message c)))))
    (eval expr env)))
(define (show label v) (write (list label v)) (newline))
(show 'alter-own-connection
  (run '(let* ((db (open-database ":memory:")))
          (call-with-statement db "create table t(x, y)" step!)
          (call-with-statement db "insert into t values (1, 2)" step!)
          (let* ((s (prepare-statement db "select * from t"))
                 (before (column-count s)))
            (call-with-statement db "alter table t add column z" step!)
            (let* ((after-alter (column-count s))
                   (stepped (step! s))
                   (after-step (column-count s)))
              (finalize-statement! s)
              (close-database! db)
              (list before after-alter stepped after-step))))))
(show 'commit-with-own-statement-mid-row
  (run '(let* ((db (open-database ":memory:")))
          (call-with-statement db "create table t(x)" step!)
          (call-with-statement db "begin" step!)
          (let* ((s (prepare-statement db "insert into t values (1), (2) returning x"))
                 (row (step! s))
                 (commit (guard (c (#t (list 'raised (sqlite-error-extended-code c) (sqlite-error-message c) (sqlite-busy? c))))
                           (call-with-statement db "commit" step!))))
            (finalize-statement! s)
            (call-with-statement db "rollback" step!)
            (close-database! db)
            (list row commit)))))

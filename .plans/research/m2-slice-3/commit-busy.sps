(import (rnrs) (rnrs eval) (chez-sqlite3 private conditions))
(define env (environment '(rnrs) '(chez-sqlite3 private connection) '(chez-sqlite3 private statement) '(chez-sqlite3 private conditions)))
(define (run expr) (guard (c (#t (list 'raised (if (sqlite-error? c) (list (sqlite-error-code c) (sqlite-error-message c)) (condition-message c))))) (eval expr env)))
(define (show l v) (write (list l v)) (newline))
(show 'select-mid-row
  (run '(let* ((db (open-database ":memory:")))
          (call-with-statement db "create table t(x)" step!)
          (call-with-statement db "insert into t values (1), (2)" step!)
          (call-with-statement db "begin" step!)
          (call-with-statement db "insert into t values (3)" step!)
          (let* ((s (prepare-statement db "select x from t"))
                 (row (step! s))
                 (commit (guard (c (#t (list 'raised (sqlite-error-code c) (sqlite-error-message c))))
                           (call-with-statement db "commit" step!)))
                 (open-after (guard (c (#t 'no-transaction)) (call-with-statement db "rollback" step!) 'was-open)))
            (finalize-statement! s)
            (close-database! db)
            (list row commit open-after)))))
(show 'returning-unfinished
  (run '(let* ((db (open-database ":memory:")))
          (call-with-statement db "create table t(x)" step!)
          (call-with-statement db "begin" step!)
          (let* ((s (prepare-statement db "insert into t values (1), (2) returning x"))
                 (row (step! s))
                 (commit (guard (c (#t (list 'raised (sqlite-error-code c) (sqlite-error-message c))))
                           (call-with-statement db "commit" step!))))
            (finalize-statement! s)
            (call-with-statement db "rollback" step!)
            (close-database! db)
            (list row commit)))))

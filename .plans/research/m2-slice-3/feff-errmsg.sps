(import (rnrs) (rnrs eval) (chez-sqlite3 private conditions))
(define env (environment '(rnrs) '(chez-sqlite3 private connection) '(chez-sqlite3 private statement) '(chez-sqlite3 private conditions)))
(define (run expr) (guard (c (#t (list 'raised (if (sqlite-error? c) (list (sqlite-error-extended-code c) (map char->integer (string->list (sqlite-error-message c)))) c)))) (eval expr env)))
(for-each (lambda (r) (write r) (newline))
  (list (run '(let ((db (open-database ":memory:")))
                (call-with-statement db "create table t(x)" step!)
                (call-with-statement db "create trigger tr before insert on t begin select raise(abort, '\xFEFF;boom'); end" step!)
                (dynamic-wind (lambda () #f)
                  (lambda () (call-with-statement db "insert into t values (1)" step!))
                  (lambda () (close-database! db)))))))

#!r6rs
;; load-extension!'s remainder, taken at each fuel on the owner's thread,
;; resumed on another thread: which who does each refusal name, and does any
;; run load?
(import (rnrs) (rnrs mutable-pairs) (only (chezscheme) getenv make-engine fork-thread make-mutex make-condition
                     with-mutex condition-wait condition-signal get-thread-id)
        (chez-sqlite3) (extension-build) (only (chez-sqlite3 private connection) call-with-open-handle))
(define dir (string-append (getenv "PWD") "/../probes/ext"))
(define path (extension-path (build-extensions dir) 'default))
(define (describe e)
  (cond ((sqlite-wrong-thread? e) (list 'wrong-thread (condition-who e)))
        ((sqlite-closed? e) (list 'closed (condition-who e)))
        ((assertion-violation? e) (list 'av (condition-who e) (condition-irritants e)))
        ((sqlite-error? e) (list 'sqlite-error (condition-who e) (sqlite-error-message e)))
        (else (list 'other))))
(define (on-other-thread thunk)
  (let ((m (make-mutex)) (c (make-condition)) (result #f))
    (fork-thread (lambda () (let ((v (guard (e (#t (list 'raised (describe e)))) (thunk))))
                              (with-mutex m (set! result (list v)) (condition-signal c)))))
    (with-mutex m (let loop () (unless result (condition-wait c m) (loop))))
    (car result)))
(define tally '())
(define (count! k) (let ((p (assoc k tally))) (if p (set-cdr! p (+ (cdr p) 1)) (set! tally (cons (cons k 1) tally)))))
(let loop ((fuel 1))
  (let* ((db (open-database ":memory:" '((enable-load-extension . #t))))
         (e (make-engine (lambda () (guard (x (#t (list 'raised (describe x)))) (list 'section-ran-on-thread (call-with-open-handle 'probe db (lambda (h) (get-thread-id))))))))
         (r (e fuel (lambda (left v) (list 'completed v)) (lambda (more) (list 'expired more)))))
    (if (eq? (car r) 'completed)
        (begin (close-database! db) (display (list 'completed-at fuel (cadr r))) (newline))
        (let ((v (on-other-thread (lambda () ((cadr r) 100000000 (lambda (left v) v) (lambda (m) 'expired-again))))))
          (count! v)
          (close-database! db)
          (loop (+ fuel 1))))))
(for-each (lambda (p) (write p) (newline)) (reverse tally))

(import (chezscheme))
;; Can an engine's remainder taken on one thread be resumed on another?
(define seen '())
(define m (make-mutex))
(define e (make-engine (lambda () (let loop ((i 0)) (when (< i 100000) (loop (+ i 1)))) (get-thread-id))))
(define r (e 50 (lambda (left v) (list 'completed v)) (lambda (more) (list 'expired more))))
(display (list 'main (get-thread-id) (car r))) (newline)
(define done (make-condition))
(define result #f)
(fork-thread (lambda ()
  (let ((v (guard (x (#t (list 'raised (if (message-condition? x) (condition-message x) x))))
             ((cadr r) 10000000 (lambda (left v) (list 'completed-on v)) (lambda (more) 'expired-again)))))
    (with-mutex m (set! result (list 'other-thread (get-thread-id) v)) (condition-signal done)))))
(with-mutex m (let loop () (unless result (condition-wait done m) (loop))))
(display result) (newline)

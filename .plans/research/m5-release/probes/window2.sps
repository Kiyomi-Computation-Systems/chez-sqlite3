(import (chezscheme) (chez-sqlite3))

(define (run-engine thunk first next)
  (let loop ((eng (make-engine thunk)) (fuel first) (slices 0))
    (if (> slices 200000)
        '(too-many-slices)
        (eng fuel
             (lambda (left . vals) (cons 'done vals))
             (lambda (rest) (loop rest next (+ slices 1)))))))

(define (describe c)
  (cond ((and (assertion-violation? c) (irritants-condition? c))
         (list 'assertion (and (who-condition? c) (condition-who c))
               (condition-irritants c)))
        ((sqlite-closed? c) 'closed)
        ((sqlite-error? c) (list 'sqlite (sqlite-error-code c)))
        ((condition? c) (list 'condition (and (message-condition? c) (condition-message c))))
        (else (list 'raised c))))

;; Everything but the five, on one connection the engine opens and closes.
(define (work)
  (guard (c (#t (list 'raised (describe c))))
    (let ((db (open-database ":memory:" '((busy-timeout . 10) (foreign-keys . #t)
                                          (synchronous . normal) (defensive . #t)
                                          (dqs-dml . #f) (statement-cache . 4)))))
      (execute! db "create table t (id integer primary key, name text)")
      (execute! db "begin")
      (execute! db "insert into t (name) values (?)" "a")
      (execute! db "insert into t (name) values (?)" "b")
      (execute! db "commit")
      (let* ((rows (query db "select id, name from t order by id"))
             (one (query-row db "select count(*) from t"))
             (st (prepare-statement db "select :a, ?2"))
             (_ (bind! st ":a" 7))
             (_2 (bind! st 2 "x"))
             (row? (step! st))
             (n (column-name st 0))
             (v (column-value st 1))
             (b (column-bytevector st 1))
             (_3 (reset! st))
             (_4 (clear-bindings! st))
             (_5 (bind-all! st 1 2))
             (_6 (step! st))
             (w (column-value st 0))
             (_7 (finalize-statement! st))
             (counters (list (changes db) (total-changes db) (last-insert-rowid db)
                             (in-transaction? db)))
             (opt (sqlite-compile-option? "THREADSAFE")))
        (interrupt-database! db)
        (close-database! db)
        (list rows one row? n v b w counters opt)))))

(define counts '())
(define (note! k)
  (let ((p (assoc k counts)))
    (if p (set-cdr! p (+ (cdr p) 1)) (set! counts (cons (cons k 1) counts)))))

(define plain (work))
(write (list 'plain plain)) (newline)

(for-each
 (lambda (next)
   (do ((first 1 (+ first 1))) ((> first 1500))
     (let ((r (run-engine work first next)))
       (note! (if (equal? r (list 'done plain)) (list next 'same) (list next r))))))
 '(1 2 3 5 9 40))

(for-each (lambda (p) (write p) (newline)) (reverse counts))

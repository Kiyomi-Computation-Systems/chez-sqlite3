(import (chezscheme))
(define m (make-mutex))
(define (spin n) (let loop ((i 0)) (when (< i n) (loop (+ i 1)))))
(define (free-from-another-thread?)
  (let ((r 'unset) (lk (make-mutex)) (c (make-condition)))
    (let ((t (fork-thread (lambda ()
                            (let ((got (mutex-acquire m #f)))
                              (when got (mutex-release m))
                              (with-mutex lk (set! r got) (condition-broadcast c)))))))
      (with-mutex lk (let loop () (when (eq? r 'unset) (condition-wait c lk (make-time 'time-duration 0 1)) (loop))))
      (thread-join t)
      r)))
(define trail '())
((make-engine (lambda () (with-mutex m (set! trail (cons 'before trail)) (spin 100000) (set! trail (cons 'after trail))) 'done))
 20
 (lambda (left v) (printf "completed ~s~%" v))
 (lambda (next)
   (printf "expired; trail ~s; mutex free from another thread: ~s~%" (reverse trail) (free-from-another-thread?))
   (next 100000000 (lambda (left v) (printf "resumed to ~s; trail ~s; free: ~s~%" v (reverse trail) (free-from-another-thread?)))
         (lambda (n) (printf "expired again~%")))))

#!r6rs
;; M3 slice 5's part D: the lead's sweep with a warm cache: each trial's connection has run the
;; call once already, so R's check-out is a hit. At every fuel F a FRESH
;; engine's remainder R; R resumed at G until it expires as R1; R resumed
;; again to its end; then R1 to its end. After each trial: each run answers
;; the clean call's answer or &sqlite-closed; one statement is cached and
;; none tracked outside it, none at a row; t holds the rows one call leaves
;; (from fuel 12 on, past any whole new call). Then the connection closes.
(import (rnrs) (rnrs eval) (only (chezscheme) make-engine collect collect-trip-bytes))
(define (reach lib name) (eval name (environment lib)))
(define open-database (reach '(chez-sqlite3) 'open-database))
(define close-database! (reach '(chez-sqlite3) 'close-database!))
(define query (reach '(chez-sqlite3) 'query))
(define query-row (reach '(chez-sqlite3) 'query-row))
(define query-fold (reach '(chez-sqlite3) 'query-fold))
(define execute! (reach '(chez-sqlite3) 'execute!))
(define sqlite-closed? (reach '(chez-sqlite3) 'sqlite-closed?))
(define tracked-statements (reach '(chez-sqlite3 private connection) 'tracked-statements))
(define database-cache-count (reach '(chez-sqlite3 private connection) 'database-cache-count))
(define statement-state (reach '(chez-sqlite3 private statement) 'statement-state))
(define native-counts (reach '(chez-sqlite3 private counters) 'native-counts))
(define (attempt thunk)
  (guard (e ((sqlite-closed? e) 'closed) (#t (list 'raised (if (who-condition? e) (condition-who e) e))))
    (thunk)))
(define (slice e fuel) (e fuel (lambda (left . v) (list 'completed (car v))) (lambda (m) (list 'expired m))))
(define (finish e) (let ((r (slice e 1000000))) (if (eq? (car r) 'completed) (cadr r) (finish (cadr r)))))

(define calls
  (list (cons 'execute! (lambda (db) (execute! db "insert into t values (?)" 9) 'void))
        (cons 'query (lambda (db) (query db "select x from t where x > ? and x < 9" 0)))
        (cons 'query-row (lambda (db) (query-row db "select x from t where x > ?" 0)))
        (cons 'query-fold (lambda (db) (query-fold db "select x from t where x < ?" (lambda (acc row) (+ acc 1)) 0 9)))))

(define (warm call)
  (let ((db (open-database ":memory:")))
    (execute! db "create table t (x)")
    (execute! db "insert into t values (1), (2), (3)")
    (call db)
    db))
(define (rows db) (query db "select count(*) from t"))

(define (sweep name call)
  (let* ((clean-db (warm call))
         (clean (attempt (lambda () (call clean-db))))
         (clean-cached (database-cache-count clean-db))
         (clean-rows (rows clean-db))
         (trials 0) (bad '()))
    (close-database! clean-db)
    (collect-trip-bytes (* 128 1024 1024))
    (let floop ((fuel 1))
      (collect)
      (let* ((db (warm call))
             (r (slice (make-engine (lambda () (attempt (lambda () (call db))))) fuel)))
        (close-database! db)
        (when (eq? (car r) 'expired)
          (let gloop ((g 1))
            (let* ((db (warm call))
                   (r (slice (make-engine (lambda () (attempt (lambda () (call db))))) fuel)))
              (if (not (eq? (car r) 'expired))
                  (close-database! db)
                  (let* ((R (cadr r)) (r1 (slice R g)))
                    (if (not (eq? (car r1) 'expired))
                        (begin (close-database! db) (floop (+ fuel 1)))
                        (let* ((second (finish R)) (third (finish (cadr r1)))
                               (states (map statement-state (tracked-statements db)))
                               (cached (database-cache-count db))
                               (n (rows db))
                               (ok-answer (lambda (a) (or (equal? a clean) (eq? a 'closed)))))
                          (set! trials (+ trials 1))
                          (unless (and (ok-answer second) (ok-answer third)
                                       (= cached clean-cached) (= (length states) clean-cached)
                                       (not (memq 'row states))
                                       (or (< fuel 12) (equal? n clean-rows)))
                            (set! bad (cons (list 'fuel fuel 'g g second third states cached n) bad)))
                          (close-database! db)
                          (gloop (+ g 1)))))))))))
    (display (list name 'clean clean 'cached clean-cached 'trials trials 'flagged (length bad)))
    (newline)
    (let loop ((b (reverse bad)) (shapes '()))
      (if (pair? b)
          (let* ((x (car b)) (shape (list-tail x 4)))
            (loop (cdr b) (if (assoc shape shapes)
                              (map (lambda (p) (if (equal? (car p) shape) (cons shape (+ (cdr p) 1)) p)) shapes)
                              (cons (cons shape 1) shapes))))
          (for-each (lambda (p) (write p) (newline)) shapes)))))

(display (list 'version ((reach '(chez-sqlite3) 'sqlite-version)))) (newline)
(for-each (lambda (c) (sweep (car c) (cdr c))) calls)
(display (list 'counts (native-counts))) (newline)

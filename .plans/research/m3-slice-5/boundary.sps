#!r6rs
;; Part D: where a remainder stops making a whole new call, fuel by fuel,
;; for execute! (a prepare in the second resume, at capacity 0) and for
;; references whose first expression marks them, through the same thunk.
(import (rnrs) (rnrs eval) (only (chezscheme) make-engine collect collect-trip-bytes))
(define (reach lib name) (eval name (environment lib)))
(define open-database (reach '(chez-sqlite3) 'open-database))
(define close-database! (reach '(chez-sqlite3) 'close-database!))
(define execute! (reach '(chez-sqlite3) 'execute!))
(define total-changes (reach '(chez-sqlite3) 'total-changes))
(define prepare-statement (reach '(chez-sqlite3) 'prepare-statement))
(define step! (reach '(chez-sqlite3) 'step!))
(define finalize-statement! (reach '(chez-sqlite3) 'finalize-statement!))
(define (tier db s) (let ((st (prepare-statement db s))) (let loop () (when (step! st) (loop))) (finalize-statement! st)))
(define (slice e fuel) (e fuel (lambda (left . v) (list 'completed (car v))) (lambda (m) (list 'expired m))))
(define (finish e) (let ((r (slice e 1000000))) (if (eq? (car r) 'completed) (cadr r) (finish (cadr r)))))
(define (attempt thunk) (guard (e (#t 'raised)) (thunk)))
(define marks 0)
(define (marked!) (set! marks (+ marks 1)) marks)
(define (spun n) (let loop ((i 0) (acc 0)) (if (= i n) acc (loop (+ i 1) (+ acc i)))))
(define (reference db sql . given) (let ((mark (marked!))) (spun 300)))
(define (reference2 db sql . given) (let ((mark (marked!))) (tier db "select 1") (spun 300)))
(define (calls verb)
  (case verb
    ((execute!) (lambda (db) (execute! db "insert into t values (?)" 9)))
    ((reference) (lambda (db) (reference db "insert into t values (?)" 9)))
    (else (lambda (db) (reference2 db "insert into t values (?)" 9)))))
(define (new-at verb fuel)
  (collect-trip-bytes (expt 2 27)) (collect)
  (let* ((db (open-database ":memory:" '((statement-cache . 0))))
         (_ (tier db "create table t (x)"))
         (run (calls verb))
         (r (slice (make-engine (lambda () (attempt (lambda () (run db))))) fuel)))
    (let ((answer
           (if (eq? (car r) 'completed) 'completed
               (let* ((first (finish (cadr r))) (m marks) (c (total-changes db)) (second (finish (cadr r))))
                 (if (eq? verb 'execute!) (> (total-changes db) c) (> marks m))))))
      (close-database! db)
      answer)))
(for-each (lambda (verb)
            (display verb) (display ": ")
            (let loop ((f 1)) (when (<= f 12) (display (list f (new-at verb f))) (loop (+ f 1))))
            (newline))
          '(execute! reference reference2))

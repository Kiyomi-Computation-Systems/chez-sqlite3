#!r6rs
;; Whether the script's state at R1's capture in trial (F, G) is the state a
;; run stepped one tick at a time has after F + G ticks: the block and
;; statement counts and the changes, compared at every (F, G) of a sample.
(import (rnrs) (rnrs eval) (only (chezscheme) make-engine collect collect-trip-bytes))
(define (reach lib name) (eval name (environment lib)))
(define open-database (reach '(chez-sqlite3) 'open-database))
(define close-database! (reach '(chez-sqlite3) 'close-database!))
(define prepare-statement (reach '(chez-sqlite3) 'prepare-statement))
(define step! (reach '(chez-sqlite3) 'step!))
(define finalize-statement! (reach '(chez-sqlite3) 'finalize-statement!))
(define execute-script! (reach '(chez-sqlite3) 'execute-script!))
(define total-changes (reach '(chez-sqlite3) 'total-changes))
(define native-counts (reach '(chez-sqlite3 private counters) 'native-counts))
(define (tier db sql) (let ((st (prepare-statement db sql))) (let loop () (when (step! st) (loop))) (finalize-statement! st)))
(define (fresh) (let ((db (open-database ":memory:"))) (tier db "create table t (x)") (tier db "insert into t values (1), (2), (3)") db))
(define (slice e fuel) (e fuel (lambda (left . v) (list 'completed (car v))) (lambda (m) (list 'expired m))))
(define (finish e) (let ((r (slice e 1000000))) (if (eq? (car r) 'completed) (cadr r) (finish (cadr r)))))
(define (call db) (lambda () (guard (e (#t 'raised)) (execute-script! db "insert into t values (7); insert into t values (8)"))))
(define (pos db) (list (cdr (assq 'block (native-counts))) (cdr (assq 'statement (native-counts))) (total-changes db)))
(collect-trip-bytes (expt 2 27)) (collect)
;; the stepped run
(define stepped
  (let* ((db (fresh)) (base (total-changes db)))
    (let loop ((e (make-engine (call db))) (t 1) (acc '()))
      (let ((r (slice e 1)))
        (if (eq? (car r) 'completed)
            (begin (close-database! db) (list->vector (reverse acc)))
            (loop (cadr r) (+ t 1) (cons (pos db) acc)))))))
(display (list 'stepped-ticks (vector-length stepped))) (newline)
(define mismatches 0) (define compared 0)
(let floop ((f 1))
  (when (< f (vector-length stepped))
    (let gloop ((g 1))
      (let* ((db (fresh)) (r (slice (make-engine (call db)) f)))
        (if (eq? (car r) 'completed) (close-database! db)
            (let ((r1 (slice (cadr r) g)))
              (if (eq? (car r1) 'completed)
                  (begin (finish (cadr r)) (close-database! db))
                  (let ((p (pos db)) (t (+ f g)))
                    (set! compared (+ compared 1))
                    (unless (and (<= t (vector-length stepped)) (equal? p (vector-ref stepped (- t 1))))
                      (when (< mismatches 5) (write (list 'f f 'g g 'trial p 'stepped (and (<= t (vector-length stepped)) (vector-ref stepped (- t 1))))) (newline))
                      (set! mismatches (+ mismatches 1)))
                    (finish (cadr r)) (finish (cadr r1)) (close-database! db)
                    (when (< g 400) (gloop (+ g 7)))))))))
    (floop (+ f 13))))
(display (list 'compared compared 'mismatches mismatches)) (newline)

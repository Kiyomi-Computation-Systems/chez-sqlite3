#!r6rs
;; Part D's mechanism probe: for each of execute!, query and query-row, the
;; first few trials of the lead's schedule that leave a statement tracked
;; outside the cache, with the tracked statements (their identity, SQL and
;; state) and the cache's count at each step: R1 taken, R run, R1 run.
(import (rnrs) (rnrs eval) (only (chezscheme) make-engine collect))
(define (reach lib name) (eval name (environment lib)))
(define open-database (reach '(chez-sqlite3) 'open-database))
(define close-database! (reach '(chez-sqlite3) 'close-database!))
(define query (reach '(chez-sqlite3) 'query))
(define query-row (reach '(chez-sqlite3) 'query-row))
(define execute! (reach '(chez-sqlite3) 'execute!))
(define tracked-statements (reach '(chez-sqlite3 private connection) 'tracked-statements))
(define database-cache-count (reach '(chez-sqlite3 private connection) 'database-cache-count))
(define statement-state (reach '(chez-sqlite3 private statement) 'statement-state))
(define statement-sql (reach '(chez-sqlite3 private statement) 'statement-sql))
(define (what e) (if (and (condition? e) (who-condition? e)) (list (condition-who e) (condition-message e)) 'raised))
(define (attempt thunk) (guard (e (#t (list 'raised (what e)))) (thunk)))
(define (slice e fuel) (e fuel (lambda (left . v) (list 'completed (car v))) (lambda (m) (list 'expired m))))
(define (finish e) (let ((r (slice e 1000000))) (if (eq? (car r) 'completed) (cadr r) (finish (cadr r)))))
(define ids '())
(define (id-of st)
  (let ((p (assq st ids)))
    (if p (cdr p) (let ((n (length ids))) (set! ids (cons (cons st n) ids)) n))))
(define (snapshot db)
  (list 'cached (database-cache-count db)
        'tracked (let loop ((r (tracked-statements db)) (acc '()))
                   (if (null? r) (reverse acc)
                       (loop (cdr r) (cons (list (id-of (car r)) (statement-state (car r))) acc))))))
(define (fresh)
  (let ((db (open-database ":memory:")))
    (execute! db "create table t (x)")
    (execute! db "insert into t values (1), (2), (3)")
    db))
(define calls
  (list (cons 'execute! (lambda (db) (execute! db "insert into t values (?)" 9)))
        (cons 'query (lambda (db) (query db "select x from t where x > ?" 0)))
        (cons 'query-row (lambda (db) (query-row db "select x from t where x > ?" 0)))))
(define shown 0)
;; one-trial : -> (U 'completed 'last 'trial)
(define (one-trial name call fuel g)
  (let* ((db (fresh))
         (r (begin (set! ids '()) (for-each id-of (tracked-statements db))
                   (slice (make-engine (lambda () (attempt (lambda () (call db))))) fuel))))
    (if (not (eq? (car r) 'expired))
        (begin (close-database! db) 'completed)
        (let* ((R (cadr r)) (r1 (slice R g)))
          (if (not (eq? (car r1) 'expired))
              (begin (close-database! db) 'last)
              (let* ((s0 (snapshot db))
                     (second (finish R))
                     (s1 (snapshot db))
                     (third (finish (cadr r1)))
                     (s2 (snapshot db)))
                (when (and (< shown 3) (> (length (cadddr s2)) (cadr s2)))
                  (set! shown (+ shown 1))
                  (write (list name 'fuel fuel 'g g)) (newline)
                  (write (list 'R1-taken s0)) (newline)
                  (write (list 'R-ran second s1)) (newline)
                  (write (list 'R1-ran third s2)) (newline))
                (close-database! db)
                'trial))))))
(define (probe name call)
  (set! shown 0)
  (let floop ((fuel 1))
    (let gloop ((g 1))
      (case (one-trial name call fuel g)
        ((completed) 'done)
        ((last) (floop (+ fuel 1)))
        (else (gloop (+ g 1)))))))
(for-each (lambda (c) (probe (car c) (cdr c))) calls)

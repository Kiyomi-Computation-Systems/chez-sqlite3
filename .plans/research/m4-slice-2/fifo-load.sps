(import (chezscheme))
(define args (command-line-arguments))
(define lib (car args))
(define fifo (cadr args))
(define mode (string->symbol (caddr args)))
(load-shared-object lib)
(define open-v2 (foreign-procedure __collect_safe "sqlite3_open_v2" (uptr uptr int uptr) int))
(define close-db (foreign-procedure __collect_safe "sqlite3_close" (uptr) int))
(define db-config (foreign-procedure (__varargs_after 2) "sqlite3_db_config" (uptr int int uptr) int))
(define load-safe (foreign-procedure __collect_safe "sqlite3_load_extension" (uptr uptr uptr uptr) int))
(define load-plain (foreign-procedure "sqlite3_load_extension" (uptr uptr uptr uptr) int))
(define sfree (foreign-procedure "sqlite3_free" (uptr) void))
(define (cstr s) (let* ((b (string->utf8 s)) (n (bytevector-length b)) (p (foreign-alloc (+ n 1))))
  (do ((i 0 (+ i 1))) ((= i n)) (foreign-set! 'unsigned-8 p i (bytevector-u8-ref b i)))
  (foreign-set! 'unsigned-8 p n 0) p))
(define (ctext a) (if (= a 0) #f (let loop ((n 0)) (if (= 0 (foreign-ref 'unsigned-8 a n)) (let ((bv (make-bytevector n))) (do ((i 0 (+ i 1))) ((= i n)) (bytevector-u8-set! bv i (foreign-ref 'unsigned-8 a i))) (utf8->string bv)) (loop (+ n 1))))))
(define slot (foreign-alloc 8))
(foreign-set! 'uptr slot 0 0)
(define name (cstr ":memory:"))
(define rc (open-v2 name slot (logior 2 4 #x10000 #x2000000) 0))
(define db (foreign-ref 'uptr slot 0))
(define cell (foreign-alloc 4))
(foreign-set! 'int cell 0 -77)
(printf "open ~a config ~a " rc (db-config db 1005 1 cell))
(printf "cell ~a~%" (foreign-ref 'int cell 0))
(define t0 (real-time))
(define m (make-mutex))
(define calling #f) (define load-at #f) (define coll-at #f) (define rel #f)
(fork-thread (lambda ()
  (let wait () (unless (with-mutex m calling) (sleep (make-time 'time-duration 10000000 0)) (wait)))
  (sleep (make-time 'time-duration 0 1))
  (collect-rendezvous)
  (with-mutex m (set! coll-at (- (real-time) t0)))
  (let ((s (system (format "sh -c 'exec 3<>\"$1\"' sh ~a" fifo))))
    (with-mutex m (set! rel (list (- (real-time) t0) s))))))
(sleep (make-time (quote time-duration) 200000000 0))
(fork-thread (lambda ()
  (let ((p (cstr fifo)) (err (foreign-alloc 8)))
    (foreign-set! 'uptr err 0 0)
    (with-mutex m (set! calling #t))
    (let* ((r ((if (eq? mode 'plain) load-plain load-safe) db p 0 err))
           (msg (foreign-ref 'uptr err 0)))
      (with-mutex m (set! load-at (list (- (real-time) t0) r (ctext msg))))
      (unless (= msg 0) (sfree msg))))))
(let wait ((i 0))
  (unless (or (> i 3000) (with-mutex m (and load-at coll-at rel)))
    (sleep (make-time 'time-duration 10000000 0)) (wait (+ i 1))))
(printf "load ~s collected ~s released ~s~%" load-at coll-at rel)
(close-db db)

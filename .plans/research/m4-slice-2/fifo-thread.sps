(import (chezscheme))
(define args (command-line-arguments))
(define lib (car args))
(define fifo (cadr args))
(load-shared-object lib)
(define open-v2 (foreign-procedure __collect_safe "sqlite3_open_v2" (uptr uptr int uptr) int))
(define db-config (foreign-procedure (__varargs_after 2) "sqlite3_db_config" (uptr int int uptr) int))
(define load-safe (foreign-procedure __collect_safe "sqlite3_load_extension" (uptr uptr uptr uptr) int))
(define (cstr s) (let* ((b (string->utf8 s)) (n (bytevector-length b)) (p (foreign-alloc (+ n 1))))
  (do ((i 0 (+ i 1))) ((= i n)) (foreign-set! 'unsigned-8 p i (bytevector-u8-ref b i)))
  (foreign-set! 'unsigned-8 p n 0) p))
(define slot (foreign-alloc 8))
(foreign-set! 'uptr slot 0 0)
(open-v2 (cstr ":memory:") slot (logior 2 4 #x10000 #x2000000) 0)
(define db (foreign-ref 'uptr slot 0))
(define cell (foreign-alloc 4))
(db-config db 1005 1 cell)
(define t0 (real-time))
(define m (make-mutex))
(define load-at #f) (define started-at #f)
(fork-thread (lambda ()
  (let ((err (foreign-alloc 8)))
    (foreign-set! 'uptr err 0 0)
    (let ((r (load-safe db (cstr fifo) 0 err)))
      (with-mutex m (set! load-at (- (real-time) t0)))))))
(sleep (make-time 'time-duration 500000000 0))
(define forked-at (- (real-time) t0))
(fork-thread (lambda () (with-mutex m (set! started-at (- (real-time) t0)))))
(define returned-at (- (real-time) t0))
(let wait ((i 0))
  (unless (or (> i 3000) (with-mutex m (and load-at started-at)))
    (sleep (make-time 'time-duration 10000000 0)) (wait (+ i 1))))
(printf "fork-thread called ~a, returned ~a; new thread ran ~a; load returned ~a~%" forked-at returned-at started-at load-at)

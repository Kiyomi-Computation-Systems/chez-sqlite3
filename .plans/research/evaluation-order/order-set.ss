(load-shared-object "libc.so.6")
(define g #f)
(set! g (lambda (x) (display x) x))
(define getpid (foreign-procedure "getpid" () int))
(define (h x) (getpid) (display x) x)
(define (show label thunk) (display label) (display ": ") (thunk) (newline))
(show "list/set!-proc " (lambda () (list (g "a") (g "b") (g "c"))))
(show "printf/set!    " (lambda () (printf "~a~a~a" (g "a") (g "b") (g "c")) (display " <- args first")))
(show "let/set!       " (lambda () (let ([x (g "a")] [y (g "b")] [z (g "c")]) (list x y z))))
(show "list/foreign   " (lambda () (list (h "a") (h "b") (h "c"))))

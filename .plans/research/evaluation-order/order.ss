(load-shared-object "libc.so.6")
(define putchar (foreign-procedure "putchar" (int) int))
(define fflush (foreign-procedure "fflush" (uptr) int))
(define (mark label) (fflush 0) (flush-output-port (current-output-port)) (display label) (flush-output-port (current-output-port)))
(mark "top/list      : ") (list (putchar 97) (putchar 98) (putchar 99)) (fflush 0) (newline)
(mark "top/format    : ") (format "~a~a~a" (putchar 97) (putchar 98) (putchar 99)) (fflush 0) (newline)
(mark "lambda/list   : ") ((lambda () (list (putchar 97) (putchar 98) (putchar 99)))) (fflush 0) (newline)
(mark "lambda/format : ") ((lambda () (format "~a~a~a" (putchar 97) (putchar 98) (putchar 99)))) (fflush 0) (newline)
(define (k) (format "~a~a~a" (putchar 97) (putchar 98) (putchar 99)))
(mark "define/format : ") (k) (fflush 0) (newline)

    (#x0A #x0B)
    (#x0A #x0C)
    (#x0A #x0D)
    (#x0A #x20)
    (#x0A #x3B)
    (#x0C #x09)
    (#x0C #x0A)
    (#x0C #x0B)
    (#x0C #x0C)
    (#x0C #x0D)
    (#x0C #x20)
    (#x0C #x3B)
    (#x0D #x09)
    (#x0D #x0A)
    (#x0D #x0B)
    (#x0D #x0C)
    (#x0D #x0D)
    (#x0D #x20)
    (#x0D #x3B)
    (#x20 #x09)
    (#x20 #x0A)
    (#x20 #x0B)
    (#x20 #x0C)
    (#x20 #x0D)
    (#x20 #x20)
    (#x20 #x3B)
    (#x2D #x2D)
    (#x3B #x09)
    (#x3B #x0A)
    (#x3B #x0C)
    (#x3B #x0D)
    (#x3B #x20)
    (#x3B #x3B)
    ))


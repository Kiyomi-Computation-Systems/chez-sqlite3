#!r6rs
;;; The suite for (chez-sqlite3 private sql-tail): the scan of what follows a
;;; prepared statement, for anything but whitespace, comments and semicolons
;;; (R2; ADR-0014, decision 4, amended 2026-11-14). It loads no libsqlite3:
;;; SQLite's prepare joins as the full oracle in slice 3.
;;;
;;;   the oracle     every NUL-free input of 1 and of 2 bytes (65,280) against
;;;                  SQLite's own list of the ones it leaves empty, generated
;;;                  by .plans/research/m2-slice-1/tail-accepted.sps on Guix's
;;;                  library and pasted here as a literal; the 798 inputs of 3
;;;                  bytes SQLite leaves empty, also a literal, which the
;;;                  scanner accepts, and every 3-byte input over a 14-byte
;;;                  alphabet (2,744), accepted exactly when listed; the inputs
;;;                  holding a NUL against our rule, which refuses them before
;;;                  a scan
;;;   the edges      each rule's edges at chosen inputs and offsets: -, --,
;;;                  /*, /**/, /*/, EF BB (BF), a vertical tab after ; after
;;;                  */ and after a comment's newline, and a NUL
;;;   every position a non-blank byte inserted at every offset of a tail of
;;;                  whitespace and comments, and every START over one longer
;;;                  SQL
;;;   every byte     /*, -- and EF BB each followed by all 256 bytes
;;;
;;; sql-tail-statement is total, so each call is made under a guard that
;;; answers a symbol of its own, and an answer of #f is read as none: SRFI-64
;;; turns a raise in the actual expression into #f.
(import (rnrs)
        (srfi :64)
        (only (chezscheme) library-exports)
        (chez-sqlite3-testing)
        (chez-sqlite3 private sql-tail))

;; SRFI-64 sets no exit status. This suite's last line turns the runner's
;; counts into one.
(define runner (test-runner-simple))
(test-runner-current runner)

;; The simple runner names a failing test but not its values. Print both.
(let ((simple-end (test-runner-on-test-end runner)))
  (test-runner-on-test-end! runner
    (lambda (r)
      (simple-end r)
      (when (memq (test-result-kind r) '(fail xpass))
        (display "  expected: ")
        (write (test-result-ref r 'expected-value))
        (newline)
        (display "  actual:   ")
        (write (test-result-ref r 'actual-value))
        (newline)))))

;; sorted-names : (Listof Symbol) -> (Listof Symbol)
(define (sorted-names names)
  (list-sort (lambda (a b) (string<? (symbol->string a) (symbol->string b))) names))

;; bv : Byte ... -> Bytevector
(define (bv . bytes) (u8-list->bytevector bytes))

;; scan : Bytevector Natural -> (U Natural 'none (raised TEXT))
;; sql-tail-statement's answer, #f as none.
(define (scan b start)
  (guard (e (#t (list 'raised (describe e))))
    (let ((o (sql-tail-statement b start))) (if (eq? o #f) 'none o))))

;; scan-string : String Natural -> (U Natural 'none)
(define (scan-string s start) (scan (string->utf8 s) start))

;; iota : Natural -> (Listof Natural)
(define (iota n)
  (let loop ((i (- n 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons i acc)))))

;; list-head : (Listof A) Natural -> (Listof A)
(define (list-head l k) (if (= k 0) '() (cons (car l) (list-head (cdr l) (- k 1)))))

;; bv-append : Bytevector ... -> Bytevector
(define (bv-append . parts)
  (u8-list->bytevector (apply append (map bytevector->u8-list parts))))

;; --- SQLite's own list ---------------------------------------------------------------------
;; The NUL-free inputs of 1 and 2 bytes that SQLite's prepare leaves empty
;; (SQLITE_OK, a NULL statement), as printed by
;; .plans/research/m2-slice-1/tail-accepted.sps on Guix's libsqlite3, 3.53.1:
;; 6 of 1 byte and 42 of 2 bytes.
(define sqlite-accepted
  '(
    (#x09)
    (#x0A)
    (#x0C)
    (#x0D)
    (#x20)
    (#x3B)
    (#x09 #x09)
    (#x09 #x0A)

(test-begin "sql-tail")

(test-equal "(chez-sqlite3 private sql-tail) exports exactly the scanner"
  '(sql-tail-statement)
  (guard (e (#t (list 'raised (describe e))))
    (sorted-names (library-exports '(chez-sqlite3 private sql-tail)))))

(test-equal "SQLite's list holds the 6 + 42 inputs the probe counted"
  '(6 42)
  (list (length (filter (lambda (i) (= (length i) 1)) sqlite-accepted))
        (length (filter (lambda (i) (= (length i) 2)) sqlite-accepted))))

;; A set of the 2-byte inputs, and of the 1-byte, from the literal.
(define accepted-1 (make-vector 256 #f))
(define accepted-2 (make-vector 65536 #f))
(for-each (lambda (i)
            (if (= (length i) 1)
                (vector-set! accepted-1 (car i) #t)
                (vector-set! accepted-2 (+ (* 256 (car i)) (cadr i)) #t)))
          sqlite-accepted)

(test-equal "every NUL-free 1-byte input, 255 of them: accepted by the scanner (#f) exactly when SQLite accepts it, mismatches listed"
  '()
  (let loop ((a 1) (bad '()))
    (if (= a 256)
        (reverse bad)
        (loop (+ a 1)
              (if (eq? (eq? (scan (bv a) 0) 'none) (vector-ref accepted-1 a))
                  bad
                  (cons a bad))))))

(test-equal "every NUL-free 2-byte input, 65,025 of them: accepted by the scanner exactly when SQLite accepts it, mismatches listed"
  '()
  (let outer ((a 1) (bad '()))
    (if (= a 256)
        (reverse bad)
        (outer (+ a 1)
               (let inner ((b 1) (bad bad))
                 (if (= b 256)
                     bad
                     (inner (+ b 1)
                            (if (eq? (eq? (scan (bv a b) 0) 'none)
                                     (vector-ref accepted-2 (+ (* 256 a) b)))
                                bad
                                (if (< (length bad) 8) (cons (list a b) bad) bad)))))))))

(test-equal "SQLite's 3-byte list holds the 798 inputs the probe counted: 1 of them EF BB BF, 255 of them 2F 2A and a byte, all of 3 bytes and NUL-free"
  '(798 1 255 #t)
  (list (length sqlite-accepted-3)
        (length (filter (lambda (i) (equal? i '(#xef #xbb #xbf))) sqlite-accepted-3))
        (length (filter (lambda (i) (and (= (car i) #x2f) (= (cadr i) #x2a))) sqlite-accepted-3))
        (for-all (lambda (i) (and (= (length i) 3) (for-all (lambda (b) (< 0 b 256)) i)))
                 sqlite-accepted-3)))

(test-equal "every 3-byte input SQLite accepts, 798 of them, is accepted by the scanner: the ones it answers an offset for, listed"
  '()
  (filter (lambda (i) (not (eq? (scan (u8-list->bytevector i) 0) 'none))) sqlite-accepted-3))

;; The 14-byte alphabet of .plans/research/m2-slice-1/tail.sps: the bytes the
;; scanner's rules name, and a letter.
(define alphabet '(#x20 #x09 #x0a #x0b #x0c #x0d #x3b #x2d #x2f #x2a #xef #xbb #xbf #x41))

(define accepted-3 (make-eqv-hashtable))
(for-each (lambda (i)
            (hashtable-set! accepted-3 (+ (* 65536 (car i)) (* 256 (cadr i)) (caddr i)) #t))
          sqlite-accepted-3)

(test-equal "every 3-byte input over the 14-byte alphabet, 2,744 of them, is accepted by the scanner exactly when SQLite's list holds it: the mismatches, listed, and the count of inputs"
  '(() 2744)
  (let ((bad '()) (count 0))
    (for-each
     (lambda (a)
       (for-each
        (lambda (b)
          (for-each
           (lambda (c)
             (set! count (+ count 1))
             (unless (eq? (eq? (scan (bv a b c) 0) 'none)
                          (hashtable-ref accepted-3 (+ (* 65536 a) (* 256 b) c) #f))
               (set! bad (cons (list a b c) bad))))
           alphabet))
        alphabet))
     alphabet)
    (list (reverse bad) count)))

;; Our rule for what holds a NUL: 00 is anything else, so it is the answer
;; unless a byte of whitespace or a semicolon came before it.
;; nul-expected : (Listof Byte) -> Natural
(define (nul-expected input)
  (cond ((null? (cdr input)) 0)
        ((and (= (cadr input) 0) (memv (car input) '(#x20 #x09 #x0a #x0c #x0d #x3b))) 1)
        (else 0)))

(test-equal "every input holding a NUL, 511 of 1 and 2 bytes: the NUL, or what comes before it, is anything else, by our rule, mismatches listed"
  '()
  (let ((inputs (append (list '(0))
                        (map (lambda (a) (list a 0)) (iota 256))
                        (map (lambda (b) (list 0 b)) (iota 256)))))
    (filter (lambda (i)
              (not (equal? (scan (u8-list->bytevector i) 0) (nul-expected i))))
            inputs)))

(test-equal "the inputs holding a NUL number 511: 1 + 256 + 256 less (0 0) counted twice"
  511
  (length (let loop ((a 0) (acc '()))
            (if (= a 256)
                acc
                (loop (+ a 1)
                      (let inner ((b 0) (acc acc))
                        (if (= b 256)
                            acc
                            (inner (+ b 1) (if (or (= a 0) (= b 0)) (cons (list a b) acc) acc)))))))))

;; --- the edges ---------------------------------------------------------------------------

(test-equal "no SQL, and a START at the length or past it, answer none"
  '(none none none none none)
  (list (scan (bv) 0) (scan-string "abc" 3) (scan-string "abc" 4) (scan-string "abc" 1000)
        (scan-string "  ;" 3)))

(test-equal "a byte that is anything else is its own offset, from any START: x, a digit, a quote, a bracket"
  '(0 2 2 0 0)
  (list (scan-string "x" 0) (scan-string "  x" 1) (scan-string "x x" 2)
        (scan-string "1" 0) (scan-string "'" 0)))

(test-equal "whitespace: space, tab, newline, form feed and carriage return, alone and in a run, are none"
  '(none none none none none none)
  (map (lambda (s) (scan-string s 0))
       (list " " "\t" "\n" "\x0c;" "\r" " \t\n\x0c;\r  ")))

(test-equal "0B alone starts anything else; 0B after one of the five continues a run; after ; or */ or a comment's newline it is the answer or part of the run, by what came before"
  '(0 none 1 1 7 none none)
  (list (scan (bv #x0b) 0) (scan (bv #x20 #x0b) 0) (scan (bv #x3b #x0b) 0)
        (scan (bv #x3b #x0b #x20) 0)
        (scan-string "/* c */\v" 0)
        (scan (bv #x2d #x2d #x63 #x0a #x0b) 0)
        (scan (bv #x20 #x0b #x0b #x0d #x0b) 0)))

(test-equal "0B after a run of whitespace that follows ;, */ or --'s newline continues the run; only straight after ; or */ it starts something else"
  '(none none none 2 10 none)
  (list (scan (bv #x3b #x20 #x0b) 0) (scan (bv #x2f #x2a #x2a #x2f #x20 #x0b) 0)
        (scan (bv #x2d #x2d #x0a #x0b) 0)
        (scan (bv #x3b #x3b #x0b) 0) (scan-string "/* c */ \v;\v" 0)
        (scan (bv #x2d #x2d #x0a #x20 #x0b #x3b) 0)))

(test-equal "- alone, and -x, start anything else; -- alone is a comment; -- to the next newline, which is not consumed"
  '(0 0 none none none 5 none)
  (list (scan (bv #x2d) 0) (scan (bv #x2d #x78) 0) (scan (bv #x2d #x2d) 0)
        (scan-string "-- a comment" 0) (scan-string "--\n" 0)
        (scan-string "-- c\nx" 0) (scan-string "-- c\n--d\n  " 0)))

(test-equal "a line comment's newline is whitespace, so what follows is scanned on: x after a --'s line is the answer, and a second comment is none"
  '(5 11 none)
  (list (scan-string "-- c\nx" 0) (scan-string "-- c\n-- d\n;x" 0) (scan-string "--a\n--b\n;" 0)))

(test-equal "/* with at least one byte after it is a comment to the end or past the first */; /* as the last two bytes is anything else"
  '(0 none none none none 4 2 none)
  (list (scan-string "/*" 0) (scan-string "/*x" 0) (scan-string "/* c" 0) (scan-string "/*/" 0)
        (scan-string "/**/" 0) (scan-string "/**/x" 0) (scan-string "  /*" 2)
        (scan-string "/* c */  ;" 0)))

(test-equal "/**/ closes where /*/ does not: the byte after is the answer for the first, and swallowed by the second"
  '(4 none 5 none)
  (list (scan-string "/**/x" 0) (scan-string "/*/x" 0) (scan-string "/*/*/x" 0)
        (scan-string "/*/ x */" 0)))

(test-equal "a * or / alone, */ alone, and / followed by a byte that is not * start anything else"
  '(0 0 0 0)
  (list (scan-string "*" 0) (scan-string "/" 0) (scan-string "*/" 0) (scan-string "/x" 0)))

(test-equal "EF BB without BF is anything else; EF BB BF is whitespace alone, after whitespace, doubled, and between ;"
  '(0 0 0 none none none none 3 1)
  (list (scan (bv #xef) 0) (scan (bv #xef #xbb) 0) (scan (bv #xef #xbb #x41) 0)
        (scan (bv #xef #xbb #xbf) 0) (scan (bv #xef #xbb #xbf #xef #xbb #xbf) 0)
        (scan (bv #x20 #xef #xbb #xbf #x20) 0)
        (scan (bv #x3b #xef #xbb #xbf #x3b) 0)
        (scan (bv #xef #xbb #xbf #x78) 0)
        (scan (bv #x20 #xef #xbb) 0)))

(test-equal "U+0085 and U+00A0 are no whitespace, and a NUL is anything else except inside a comment"
  '(0 0 0 2 1 none none)
  (list (scan (bv #xc2 #x85) 0) (scan (bv #xc2 #xa0) 0) (scan (bv 0) 0) (scan (bv #x20 #x20 0) 0)
        (scan (bv #x3b 0) 0) (scan (bv #x2d #x2d 0) 0) (scan (bv #x2f #x2a 0) 0)))

(test-equal "the tail after a first statement: from where prepare leaves it, whitespace and semicolons are none, anything else its offset"
  '(10 10 none none 11 none)
  (list (scan-string "select 1; select 2" 9) (scan-string "select 1; select 2" 8)
        (scan-string "select 1;;" 9) (scan-string "select 1;" 9)
        (scan-string "select 1 ; x" 10)
        (scan-string "select 1 -- c\n; " 8)))

;; --- every START over one longer SQL -----------------------------------------------------------

;; Offsets, by hand: s0 e1 l2 e3 c4 t5 _6 1(7) ;8 _9 -10 -11 _12 c13 \n14 _15
;; /16 *17 _18 d19 _20 *21 /22 _23 ;24 \v25 _26 x27, 28 bytes.
(define longer "select 1; -- c\n /* d */ ;\v x")

(test-equal "the longer SQL is 28 bytes"
  28
  (bytevector-length (string->utf8 longer)))

(test-equal "every START from 0 to the length over the longer SQL: the answers, written out by hand, from inside a comment too"
  '(0 1 2 3 4 5 7 7 25 25 25 11 13 13 25 25 25 17 19 19 21 21 22 25 25 25 27 27 none)
  (map (lambda (start) (scan-string longer start)) (iota 29)))

(test-equal "a START past the longer SQL's length answers none"
  '(none none none)
  (map (lambda (start) (scan-string longer start)) '(29 30 100000000000000000000)))

;; --- a non-blank byte at every offset of a tail ------------------------------------------------

;; Tokens of a tail of whitespace, semicolons, comments and U+FEFF. The
;; kinds: ws, semi, line (a -- comment, its newline a ws token of its own),
;; block, bom.
(define tail-tokens
  (list (cons 'ws "  \t") (cons 'semi ";") (cons 'line "-- c") (cons 'ws "\n")
        (cons 'block "/* d */") (cons 'ws "\x0c;\r") (cons 'bom "\xfeff;") (cons 'semi ";")
        (cons 'line "--") (cons 'ws "\n  ") (cons 'block "/**/") (cons 'semi ";")))

;; token-bytes : Token -> Bytevector
(define (token-bytes t) (string->utf8 (cdr t)))

;; inserted : Natural Byte -> (List Bytevector Natural)
;; The tail with X inserted before its byte K, and the offset the scan must
;; answer, by structure: K itself at a boundary or inside whitespace; the
;; token's start when K splits a two-byte opener or a U+FEFF; none when K is
;; inside a comment's body or terminator, where it is swallowed.
(define (insertions x)
  (let loop ((ts tail-tokens) (k 0) (acc '()) (previous #f))
    (if (null? ts)
        (reverse (cons (list k k) acc))
        (let* ((len (bytevector-length (token-bytes (car ts))))
               (kind (car (car ts)))
               (rows (map (lambda (j)
                            (list (+ k j)
                                  (cond ((and (= j 0) (eq? previous 'line)) 'none)
                                        ((= j 0) (+ k j))
                                        ((eq? kind 'ws) (+ k j))
                                        ((eq? kind 'bom) k)
                                        ((= j 1) k)
                                        (else 'none))))
                          (iota len))))
          (loop (cdr ts) (+ k len) (append (reverse rows) acc) kind)))))

;; the whole tail's bytes
(define tail-bytes (apply bv-append (map token-bytes tail-tokens)))

(test-equal "the tail alone, from 0, is none"
  'none
  (scan tail-bytes 0))

(test-equal "the tail's length is 32 bytes, so the insertion points below cover 33 offsets"
  '(32 33)
  (list (bytevector-length tail-bytes) (length (insertions 120))))

(test-equal "x inserted at every offset of the tail, 0 to its length: the offset, from a token's start when it splits an opener or U+FEFF, and none inside a comment"
  '()
  (let ((bytes (bytevector->u8-list tail-bytes)))
    (filter
     (lambda (row)
       (let* ((k (car row))
              (input (u8-list->bytevector
                      (append (list-head bytes k) (list 120) (list-tail bytes k)))))
         (not (equal? (scan input 0) (cadr row)))))
     (insertions 120))))

(test-equal "x inserted at every offset of the tail, after a prefix, from the prefix's length: the same answers, shifted"
  '()
  (let ((bytes (bytevector->u8-list tail-bytes))
        (prefix '(115 101 108 101 99 116 32 49)))
    (filter
     (lambda (row)
       (let* ((k (car row))
              (input (u8-list->bytevector
                      (append prefix (list-head bytes k) (list 120) (list-tail bytes k))))
              (expected (if (eq? (cadr row) 'none) 'none (+ 8 (cadr row)))))
         (not (equal? (scan input 8) expected))))
     (insertions 120))))

(test-equal "the insertions cover each kind of answer: a boundary, a split opener, a swallowed byte"
  '(#t #t #t)
  (let ((answers (map cadr (insertions 120))))
    (list (and (memv 0 answers) #t)
          (and (exists (lambda (row) (and (number? (cadr row)) (< (cadr row) (car row)))) (insertions 120))
               #t)
          (and (memq 'none answers) #t))))

;; --- every byte after the openers -------------------------------------------------------------------

(test-equal "/* followed by each of the 256 bytes is a comment to the end: none for every one"
  '()
  (filter (lambda (b) (not (eq? (scan (bv #x2f #x2a b) 0) 'none))) (iota 256)))

(test-equal "-- followed by each of the 256 bytes is a comment, a newline ending it into whitespace: none for every one"
  '()
  (filter (lambda (b) (not (eq? (scan (bv #x2d #x2d b) 0) 'none))) (iota 256)))

(test-equal "EF BB followed by each of the 256 bytes: none for BF alone, and offset 0 for every other"
  '(none)
  (let ((answers (map (lambda (b) (scan (bv #xef #xbb b) 0)) (iota 256))))
    (list (if (and (eq? (list-ref answers #xbf) 'none)
                   (for-all (lambda (b) (eqv? (list-ref answers b) 0))
                            (filter (lambda (b) (not (= b #xbf))) (iota 256))))
              'none
              answers))))

(test-end "sql-tail")

(exit (suite-exit-status runner))
